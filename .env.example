# Boot (required)
MONGO_URI=mongodb://localhost:27017/nuri-task-db
JWT_SECRET=change-me-jwt-secret
PORT=3000
NODE_ENV=development

# Frontend / API public URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# Email (Gmail app password — not the account password)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=change-me@gmail.com
EMAIL_PASSWORD=change-me-app-password
EMAIL_FROM_NAME=Nuri Task API

# Google OAuth
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret

# Mercado Pago (fail-closed without MP_WEBHOOK_SECRET)
MP_ACCESS_TOKEN=change-me-mp-access-token
MP_WEBHOOK_SECRET=change-me-mp-webhook-secret
MP_SUBSCRIPTION_AMOUNT=15

# Cron (fail-closed without CRON_SECRET)
CRON_SECRET=change-me-cron-secret

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me
