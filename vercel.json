{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/dispatch?h=0",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=1",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=2",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=3",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=4",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=5",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=6",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=7",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=8",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=9",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=10",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=11",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=12",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=13",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=14",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=15",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=16",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=17",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=18",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=19",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=20",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=21",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=22",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/dispatch?h=23",
      "schedule": "0 23 * * *"
    }
  ],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/swagger-ui/(.*)",
      "destination": "/public/swagger-ui/$1"
    },
    {
      "source": "/api-docs",
      "destination": "/index.js"
    },
    {
      "source": "/api-docs/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/css/(.*)",
      "destination": "/public/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/public/js/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
