{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 23 * * *"
    }
  ],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/swagger-ui/(.*)",
      "destination": "/public/swagger-ui/$1"
    },
    {
      "source": "/api-docs",
      "destination": "/index.js"
    },
    {
      "source": "/api-docs/(.*)",
      "destination": "/index.js"
    },
    {
      "source": "/css/(.*)",
      "destination": "/public/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/public/js/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}
